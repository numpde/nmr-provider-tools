+++ b/tests/host/test_shared_identity_adapter.py
@@ -0,0 +1,123 @@
+"""Run the actual host adapter without importing the contained science runtime.
+
+These import the maintained host module normally. The shared operation is
+replaced at its public Python boundary; requests, maps and failures are real types.
+They do not qualify Docker, host namespaces, or the complete deployment command.
+"""
+
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from deployment import provider_deployment
+
+from provider_deploy.linux import IdMap, IdRange, ProcessIdentity
+from provider_deploy.model import Problem, ProbeFailure, ProbeHandle, ResourceState, Retirement
+from provider_deploy.operation import ProbeResult
+
+
+IDENTITY_MAP = IdMap((IdRange(0, 0, 4294967295),))
+ROOTLESS_MAP = IdMap((IdRange(0, 1000, 1), IdRange(1, 100000, 65536)))
+
+
+class SharedIdentityAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.adapter = provider_deployment
+        self.saved = []
+        self.image = "sha256:" + "a" * 64
+        self.enterContext(patch.dict(os.environ, {
+            "NMRPEAK_DOCKER_HOST": "unix:///selected.sock",
+            "DOCKER_HOST": "unix:///wrong.sock", "DOCKER_CONTEXT": "wrong"}))
+
+    def completed(self, request, *, executable):
+        self.saved.append((request, executable))
+        self.assertFalse(hasattr(request, "receipt_path"))
+        return ProbeResult(ROOTLESS_MAP, ROOTLESS_MAP, "c" * 64)
+
+    def test_delegates_exact_selected_engine_image_user_and_executable(self):
+        with patch("provider_deploy.probe_identity", side_effect=self.completed) as operation:
+            result = self.adapter._container_uid_map(Path("/usr/bin/docker"), self.image)
+        operation.assert_called_once()
+        request, executable = self.saved[0]
+        self.assertEqual(request.endpoint, "unix:///selected.sock")
+        self.assertEqual(request.image, self.image)
+        self.assertEqual(request.interpreter, "/usr/local/bin/python3.12")
+        self.assertEqual((request.user_uid, request.user_gid), (65532, 65532))
+        self.assertEqual(executable, "/usr/bin/docker")
+        self.assertIs(result, ROOTLESS_MAP)
+
+    def test_probe_adapter_needs_no_private_storage(self):
+        def unexpected_storage(**_kwargs):
+            raise AssertionError("identity adaptation must not allocate a receipt directory")
+        with patch.object(self.adapter, "mkdtemp", side_effect=unexpected_storage), \
+             patch("provider_deploy.probe_identity", return_value=SimpleNamespace(uid_map=ROOTLESS_MAP)):
+            self.assertIs(self.adapter._container_uid_map(Path("/usr/bin/docker"), self.image), ROOTLESS_MAP)
+
+    def test_forward_maps_both_actual_provider_consumers(self):
+        self.assertEqual(self.adapter._mapped_host_uid(65532, IDENTITY_MAP), 65532)
+        self.assertEqual(self.adapter._mapped_host_uid(1000, IDENTITY_MAP), 1000)
+        self.assertEqual(self.adapter._mapped_host_uid(65532, ROOTLESS_MAP), 165531)
+        self.assertEqual(self.adapter._mapped_host_uid(1000, ROOTLESS_MAP), 100999)
+
+    def test_unmapped_id_becomes_provider_rejection(self):
+        with self.assertRaises(self.adapter.DeploymentOperationRejected):
+            self.adapter._mapped_host_uid(1000000, ROOTLESS_MAP)
+
+    def test_failed_probe_preserves_stage_cause_and_ownership_handle(self):
+        for state in (ResourceState.NOT_CREATED, ResourceState.RETIRED, ResourceState.UNRESOLVED):
+            with self.subTest(state=state):
+                problem = Problem("observe", "process-identity", "probe process changed")
+                cause = None
+                def fail(request, *, executable):
+                    nonlocal cause
+                    handle = ProbeHandle(request.endpoint, "a" * 32, "c" * 64,
+                                         (ProcessIdentity(4321, 123, 9, 10),))
+                    cause = ProbeFailure(problem, Retirement(state), handle)
+                    raise cause
+                expected = (self.adapter.MaintenanceInvocationUnsettled if state not in {ResourceState.NOT_CREATED, ResourceState.RETIRED}
+                            else self.adapter.DeploymentOperationRejected)
+                with patch("provider_deploy.probe_identity", side_effect=fail):
+                    with self.assertRaises(expected) as caught:
+                        self.adapter._container_uid_map(Path("/usr/bin/docker"), self.image)
+                self.assertIs(caught.exception.__cause__, cause)
