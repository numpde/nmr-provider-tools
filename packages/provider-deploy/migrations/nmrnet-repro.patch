diff --git a/tests/host/test_deploy_identity_adapter.py b/tests/host/test_deploy_identity_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..299ae12aab634a1a84dcf68b4ef88b2e3a6e0aeb
--- /dev/null
+++ b/tests/host/test_deploy_identity_adapter.py
@@ -0,0 +1,196 @@
+"""Host-only acceptance for the actual NMRNet adapter and shared CLI contract.
+
+No repository container guard is bypassed: the shell adapter under test
+is extracted from their maintained source, without launching the deployment.
+The shared CLI and ID translation are real; only its probe operation is replaced
+with a bounded synthetic result. Real-engine qualification remains separate.
+"""
+
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = (ROOT / "tools/compose_deployment.sh").read_text()
+IMAGE = "sha256:" + "a" * 64
+
+
+def shell_function(name):
+    found = re.search(rf"(?ms)^{name}\(\) \{{\n.*?^\}}", SOURCE)
+    if found is None:
+        raise AssertionError(f"maintained shell adapter {name} was not found")
+    return found.group()
+
+
+SHARED_COMMAND = r'''import json
+import os
+from dataclasses import asdict
+from pathlib import Path
+from unittest.mock import patch
+from provider_deploy import cli
+from provider_deploy.linux import IdMap, IdRange
+from provider_deploy.model import Problem, ProbeFailure, ProbeHandle, ResourceState, Retirement
+from provider_deploy.operation import ProbeResult
+
+def observe(request, *, cancel):
+    request.validate()
+    Path(os.environ['REQUEST_LOG']).write_text(json.dumps(asdict(request), default=str))
+    mode = os.environ['RESULT_MODE']
+    if mode == 'await-signal':
+        # The CLI owns real signal handlers; only the Engine effect is synthetic.
+        if cancel.wait(2):
+            raise ProbeFailure(Problem('measure', 'cancelled', 'fixture observed cancellation'),
+                               Retirement(ResourceState.RETIRED, 'b' * 64))
+    if mode == 'uncertain':
+        raise ProbeFailure(Problem('create', 'timeout', 'fixture create reply lost'),
+                           Retirement(ResourceState.UNRESOLVED), ProbeHandle(request.endpoint, 'a' * 32))
+    if mode == 'rootful':
+        uids = gids = IdMap((IdRange(0, 0, 4294967295),))
+    else:
+        shift = 1 if mode == 'foreign' else 0
+        uids = IdMap((IdRange(0, os.getuid() + shift, 1), IdRange(1, 100000, 65536)))
+        gids = IdMap((IdRange(0, os.getgid() + shift, 1), IdRange(1, 200000, 65536)))
+    return ProbeResult(uids, gids, 'b' * 64)
+
+with patch.object(cli, 'probe_identity', observe):
+    raise SystemExit(cli.main())
+'''
+
+
+class IdentityAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.root.chmod(0o700)
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        self.command = self.bin / 'provider-deploy'
+        self.command.write_text(f'#!{sys.executable}\n' + SHARED_COMMAND)
+        self.command.chmod(0o700)
+        self.request_log = self.root / 'request.json'
+        self.selected = self.root / 'selected'
+
+    # silent-defaults: allow-contract -- Ordinary rootful probes run without injected signals; cancellation tests explicitly select signal delivery and group scope; proof=tests/host/test_deploy_identity_adapter.py::IdentityAdapterTests.test_process_group_cancellation_stops_before_helper_selection
+    def run_adapter(self, mode='rootful', *, send_signal=None, signal_group=False):
+        # Assignments and policy are production functions, not a rewritten test adapter.
+        program = '\n'.join([
+            'set -euo pipefail',
+            'root=$1; caller_uid=$(id -u); caller_gid=$(id -g)',
+            'helper_uid=$caller_uid; helper_gid=$caller_gid; helper_add_chown=false',
+            'service_host_uid=$caller_uid; service_host_gid=$caller_gid',
+            'refuse() { printf "%s\\n" "$1" >&2; return 2; }',
+            'inference_diagnostic=; inference_retirement_confirmed=true',
+            'helper_name=; lifetime_query=; stop_query=',
+            'docker_client_cleanup() { : > "$root/cleaned"; }',
+            shell_function('finish'),
+            *re.findall(r'^trap .+$', SOURCE, re.MULTILINE),
+            shell_function('map_helper_identity'),
+            f'map_helper_identity {IMAGE} /opt/provider/environment/bin/python',
+            'printf "%s %s %s %s %s\\n" "$helper_uid" "$helper_gid" "$helper_add_chown" "$service_host_uid" "$service_host_gid" > "$root/selected"',
+        ])
+        env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ['PATH'],
+                   NMRNET_DOCKER_ENDPOINT_INPUT='unix:///selected-engine.sock',
+                   DOCKER_CONTEXT='unrelated-ambient-context', DOCKER_HOST='unix:///wrong.sock',
+                   REQUEST_LOG=str(self.request_log), RESULT_MODE=mode)
+        command = ['bash', '-c', program, 'bash', str(self.root)]
+        if send_signal is None:
+            return subprocess.run(command, env=env, text=True, capture_output=True, timeout=5)
+        with subprocess.Popen(command, env=env, text=True, stdout=subprocess.PIPE,
+                              stderr=subprocess.PIPE, start_new_session=True) as process:
+            try:
+                deadline = time.monotonic() + 5
+                while not self.request_log.exists():
+                    if process.poll() is not None or time.monotonic() >= deadline:
+                        self.fail('shared CLI did not enter its probe')
+                    time.sleep(0.01)
+                if signal_group:
+                    os.killpg(process.pid, send_signal)
+                else:
+                    process.send_signal(send_signal)
+                stdout, stderr = process.communicate(timeout=5)
+                return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
+            finally:
+                if process.poll() is None:
+                    os.killpg(process.pid, signal.SIGKILL)
+                    process.communicate()
+
+    def test_rootful_keeps_caller_helper_and_passes_selected_endpoint(self):
+        result = self.run_adapter()
+        self.assertEqual(0, result.returncode, msg=result.stderr)
+        self.assertEqual([str(os.getuid()), str(os.getgid()), 'false', str(os.getuid()), str(os.getgid())],
+                         self.selected.read_text().split())
+        request = json.loads(self.request_log.read_text())
+        self.assertEqual('unix:///selected-engine.sock', request['endpoint'])
+        self.assertEqual(IMAGE, request['image'])
+        self.assertEqual('/opt/provider/environment/bin/python', request['interpreter'])
+        self.assertEqual((0, 0), (request['user_uid'], request['user_gid']))
+
+    def test_rootless_chooses_container_root_and_keeps_mapped_service_ids(self):
+        result = self.run_adapter('rootless')
+        self.assertEqual(0, result.returncode, msg=result.stderr)
+        self.assertEqual(['0', '0', 'true', str(99999 + os.getuid()), str(199999 + os.getgid())],
+                         self.selected.read_text().split())
+
+    def test_foreign_mapping_does_not_authorize_input_policy(self):
+        result = self.run_adapter('foreign')
+        self.assertEqual(2, result.returncode, msg=result.stderr)
+        self.assertIn('maps neither', result.stderr)
+        self.assertFalse(self.selected.exists())
+
+    def test_uncertain_probe_returns_no_mapping_and_preserves_diagnostic(self):
+        result = self.run_adapter('uncertain')
+        self.assertEqual(3, result.returncode, msg=result.stderr)
+        self.assertEqual('', result.stdout)
+        self.assertIn('fixture create reply lost', result.stderr)
+        self.assertIn('unix:///selected-engine.sock', result.stderr)
+        self.assertIn('a' * 32, result.stderr)
+        self.assertFalse(self.selected.exists())
+
+    def test_nonzero_command_status_with_numeric_output_is_not_success(self):
+        self.command.write_text('#!/bin/sh\nprintf "0 %s 0 %s\\n" "$(id -u)" "$(id -g)"\nexit 3\n')
+        result = self.run_adapter()
+        self.assertEqual(3, result.returncode, msg=result.stderr)
+        self.assertFalse(self.selected.exists())
+
+    def test_process_group_cancellation_stops_before_helper_selection(self):
+        for number, status in ((signal.SIGINT, 130), (signal.SIGTERM, 143), (signal.SIGHUP, 143)):
+            with self.subTest(signal=number):
+                self.request_log.unlink(missing_ok=True)
+                (self.root / 'cleaned').unlink(missing_ok=True)
+                result = self.run_adapter('await-signal', send_signal=number, signal_group=True)
+                self.assertEqual(status, result.returncode, msg=result.stderr)
+                self.assertEqual('', result.stdout)
+                self.assertIn('fixture observed cancellation', result.stderr)
+                self.assertFalse(self.selected.exists())
+                self.assertTrue((self.root / 'cleaned').exists())
+
+    def test_shell_only_term_defers_trap_but_never_selects_helper(self):
+        # Bash does not forward shell-only TERM into command substitution. The
+        # bounded CLI completes first; then the real shell trap refuses progress.
+        result = self.run_adapter('await-signal', send_signal=signal.SIGTERM)
+        self.assertEqual(143, result.returncode, msg=result.stderr)
+        self.assertNotIn('fixture observed cancellation', result.stderr)
+        self.assertFalse(self.selected.exists())
+        self.assertTrue((self.root / 'cleaned').exists())
+
+    def test_corrupt_projection_does_not_authorize_input_policy(self):
+        for value in ('0 1000 0 1000 extra', '0 1000\n0 1000', '0 1000 0 -1', '0 1000 0 $(touch sentinel)'):
+            with self.subTest(value=value):
+                self.command.write_text('#!/bin/sh\nprintf "%s\\n" ' + "'" + value + "'\n")
+                result = self.run_adapter()
+                self.assertEqual(2, result.returncode, msg=result.stderr)
+                self.assertIn('invalid numeric projection', result.stderr)
+                self.assertFalse(self.selected.exists())
+
+
+
+if __name__ == '__main__':
+    unittest.main()
