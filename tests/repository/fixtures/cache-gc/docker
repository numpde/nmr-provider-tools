#!/usr/bin/env python3
"""Record selected-engine GC arguments without contacting Docker."""

import json
import os
from pathlib import Path
import sys

if sys.argv[1:3] == ["context", "inspect"]:
    print("unix:///tmp/selected-engine.sock")
else:
    Path(os.environ["GC_PROBE"]).write_text(json.dumps({
        "argv": sys.argv[1:],
        "env": {key: os.environ[key] for key in ("DOCKER_HOST", "HTTP_PROXY") if key in os.environ},
    }))
